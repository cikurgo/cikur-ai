rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function under5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Verifikasi identitas customer (KTP)
    match /customer-identity/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && under5MB();
    }

    // Dokumen mitra (KTP, SIM, STNK, foto resto, dll)
    match /mitra-docs/{userId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && under5MB();
    }

    // Tolak path lain
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
