rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ADMIN HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admin_users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admin_users/$(request.auth.uid)
        ).data.active == true;
    }

    function isSuperAdmin() {
      return isAdmin()
        && get(
          /databases/$(database)/documents/admin_users/$(request.auth.uid)
        ).data.role == "super_admin";
    }

    function actorIsCurrentUser() {
      return signedIn()
        && request.resource.data.actorUid == request.auth.uid;
    }


    // ============================================================
    // ADMIN REQUESTS
    // ============================================================

    match /admin_requests/{userId} {

      // User hanya boleh membuat request untuk dirinya sendiri.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";

      // User boleh melihat request miliknya sendiri.
      allow get: if signedIn()
        && request.auth.uid == userId;

      // Super admin boleh melihat seluruh request.
      allow list: if isSuperAdmin();

      // Hanya super admin yang dapat mengubah / menghapus request.
      allow update, delete: if isSuperAdmin();
    }


    // ============================================================
    // ADMIN USERS
    // ============================================================

    match /admin_users/{userId} {

      // Admin boleh membaca dokumen admin miliknya sendiri.
      allow get: if signedIn()
        && request.auth.uid == userId;

      // Daftar seluruh admin hanya untuk super admin.
      allow list: if isSuperAdmin();

      // Manajemen admin hanya untuk super admin.
      allow create, update, delete: if isSuperAdmin();
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // User hanya boleh membaca / menulis profil miliknya sendiri.
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }


    // ============================================================
    // CUSTOMERS
    // ============================================================

    match /customers/{userId} {

      // Customer membuat / membuat presence miliknya sendiri.
      allow create: if signedIn()
        && request.auth.uid == userId;

      // Customer sendiri atau admin boleh memperbarui.
      allow update: if
        (
          signedIn()
          && request.auth.uid == userId
        )
        ||
        isAdmin();

      // Customer sendiri atau admin boleh membaca.
      allow get, list: if
        (
          signedIn()
          && request.auth.uid == userId
        )
        ||
        isAdmin();

      // Penghapusan hanya admin.
      allow delete: if isAdmin();
    }


    // ============================================================
    // MITRA APPLICATIONS
    // ============================================================

    match /mitra_applications/{docId} {

      // Pengajuan hanya boleh dibuat atas nama UID sendiri.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      // Admin dapat membaca seluruh pengajuan.
      // Pemilik hanya dapat membaca pengajuannya sendiri.
      allow read: if isAdmin()
        ||
        (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // Admin dapat mengubah.
      //
      // Pemilik hanya dapat mengubah dokumen miliknya,
      // UID tidak boleh dipindahkan,
      // dan status tidak boleh dimanipulasi oleh pemilik.
      allow update: if
        isAdmin()
        ||
        (
          signedIn()
          && request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
        );

      // Hanya admin yang dapat menghapus.
      allow delete: if isAdmin();
    }


    // ============================================================
    // RESTO PROFILES
    // ============================================================

    match /resto_profiles/{restoId} {

      // Digunakan oleh sistem untuk membaca profil resto.
      allow read: if signedIn();

      // Pemilik resto hanya dapat mengelola profil miliknya.
      allow create, update: if signedIn()
        && request.auth.uid == restoId;

      allow delete: if signedIn()
        && request.auth.uid == restoId;
    }


    // ============================================================
    // ORDER OWNERSHIP HELPERS
    // ============================================================

    function orderBelongsToCurrentUser() {
      return signedIn()
        && resource.data.get("userId", "") == request.auth.uid;
    }

    function newOrderBelongsToCurrentUser() {
      return signedIn()
        && request.resource.data.get("userId", "") == request.auth.uid;
    }

    function orderBelongsToDriver() {
      return signedIn()
        && resource.data.get("driverId", "") == request.auth.uid;
    }

    function newOrderBelongsToDriver() {
      return signedIn()
        && request.resource.data.get("driverId", "") == request.auth.uid;
    }

    function orderBelongsToMitra() {
      return signedIn()
        && (
          resource.data.get("mitraId", "") == request.auth.uid
          || resource.data.get("restoId", "") == request.auth.uid
          || resource.data.get("restaurantId", "") == request.auth.uid
        );
    }

    function newOrderBelongsToMitra() {
      return signedIn()
        && (
          request.resource.data.get("mitraId", "") == request.auth.uid
          || request.resource.data.get("restoId", "") == request.auth.uid
          || request.resource.data.get("restaurantId", "") == request.auth.uid
        );
    }


    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // Customer membuat order miliknya sendiri.
      // Admin dapat membuat order secara operasional.
      //
      allow create: if isAdmin()
        || newOrderBelongsToCurrentUser();


      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Admin: seluruh order.
      //
      // User/Driver/Mitra:
      // akses dokumen order yang memang berkaitan dengan UID.
      //
      // LIST:
      // Sistem Driver saat ini memiliki query daftar FOOD order
      // yang siap diambil sebelum melakukan filtering client-side.
      // Karena Firestore Rules bukan filter, query tersebut tidak
      // dapat memakai ownership resource.data untuk setiap dokumen.
      //
      // Oleh karena itu list untuk user login tetap dibuka agar
      // flow aplikasi saat ini tidak rusak.
      //
      allow get: if isAdmin()
        || orderBelongsToCurrentUser()
        || orderBelongsToDriver()
        || orderBelongsToMitra();

      allow list: if signedIn();


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // Update hanya boleh dilakukan oleh admin atau pihak yang
      // terkait dengan order.
      //
      allow update: if isAdmin()
        || orderBelongsToCurrentUser()
        || orderBelongsToDriver()
        || orderBelongsToMitra();


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------
      //
      // Hanya admin.
      //
      allow delete: if isAdmin();


      // ==========================================================
      // ORDER MESSAGES
      // ==========================================================

      match /messages/{messageId} {

        // Pihak terkait order atau admin dapat membaca pesan.
        allow get, list: if isAdmin()
          || orderBelongsToCurrentUser()
          || orderBelongsToDriver()
          || orderBelongsToMitra();

        // Pihak terkait order atau admin dapat membuat pesan.
        allow create: if isAdmin()
          || orderBelongsToCurrentUser()
          || orderBelongsToDriver()
          || orderBelongsToMitra();

        // Pesan immutable setelah dibuat.
        allow update, delete: if false;
      }
    }


    // ============================================================
    // APPLICATION CONFIG
    // ============================================================

    match /app_config/{document} {

      // Konfigurasi sistem hanya untuk admin aktif.
      allow read, write: if isAdmin();
    }


    // ============================================================
    // SYSTEM LOGS / TELEMETRY
    // ============================================================

    match /system_logs/{document} {

      // Sistem yang sudah authenticated dapat mengirim telemetry.
      //
      // Dipertahankan karena BCGO dan komponen aplikasi dapat
      // menghasilkan event/log operasional.
      //
      allow create: if signedIn();

      // Hanya admin yang dapat membaca telemetry.
      allow read: if isAdmin();

      // Log immutable.
      allow update, delete: if false;
    }


    // ============================================================
    // MEDICINE MESSAGES
    // ============================================================

    match /medicine_messages/{document} {

      // Medicine messages merupakan area operasional admin.
      allow read: if isAdmin();

      // Sistem/admin dapat membuat message.
      allow create: if isAdmin();

      // Message immutable.
      allow update, delete: if false;
    }


    // ============================================================
    // MEDICINE TREATMENTS
    // ============================================================

    match /medicine_treatments/{document} {

      // Hanya admin aktif yang dapat membaca.
      allow read: if isAdmin();

      // Treatment harus membawa actorUid yang sama dengan
      // authenticated user.
      allow create: if isAdmin()
        && actorIsCurrentUser();

      // Tidak boleh dimodifikasi / dihapus setelah dibuat.
      allow update, delete: if false;
    }


    // ============================================================
    // MEDICINE PATCH REQUESTS
    // ============================================================

    match /medicine_patch_requests/{document} {

      // Hanya admin aktif yang dapat membaca request patch.
      allow read: if isAdmin();

      // Medicine dapat membuat request menuju Executor,
      // tetapi actor harus user yang sedang authenticated.
      //
      // Status awal wajib PENDING_EXECUTION.
      //
      allow create: if isAdmin()
        && actorIsCurrentUser()
        && request.resource.data.status == "PENDING_EXECUTION";

      // Request immutable dari client.
      // Executor tidak mengandalkan update Firestore client-side.
      allow update, delete: if false;
    }


    // ============================================================
    // MEDICINE VALIDATIONS
    // ============================================================

    match /medicine_validations/{document} {

      // Hanya admin aktif.
      allow read: if isAdmin();

      // Validation harus berasal dari actor authenticated yang sama.
      allow create: if isAdmin()
        && actorIsCurrentUser();

      // Validation immutable.
      allow update, delete: if false;
    }
  }
}
