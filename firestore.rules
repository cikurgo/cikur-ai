rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH / ADMIN HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.active == true;
    }

    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == "super_admin";
    }

    // Field sensitif customer — tidak boleh diubah client sembarangan
    function customerProtectedFieldsUnchanged() {
      return request.resource.data.get("saldo", 0) == resource.data.get("saldo", 0)
        && request.resource.data.get("pinHash", "") == resource.data.get("pinHash", "")
        && request.resource.data.get("pinConfigured", false) == resource.data.get("pinConfigured", false)
        && request.resource.data.get("identityVerified", false) == resource.data.get("identityVerified", false)
        && request.resource.data.get("identityVerificationStatus", "") == resource.data.get("identityVerificationStatus", "")
        && request.resource.data.get("phoneVerified", false) == resource.data.get("phoneVerified", false);
    }

    // CikurPay: saldo hanya boleh turun (tidak boleh naik dari client)
    function customerSaldoOnlyDecreased() {
      return request.resource.data.get("saldo", 0) <= resource.data.get("saldo", 0)
        && request.resource.data.get("pinHash", "") == resource.data.get("pinHash", "")
        && request.resource.data.get("identityVerified", false) == resource.data.get("identityVerified", false);
    }

    // Agent publik untuk Otak CGO / radar customer (read-only)
    function isPublicApprovedAgent() {
      return resource.data.get("jenis", "") == "agent"
        && resource.data.get("status", "") == "approved";
    }

    // ============================================================
    // ADMIN REQUESTS
    // ============================================================

    match /admin_requests/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending";

      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ============================================================
    // ADMIN USERS
    // ============================================================

    match /admin_users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // ============================================================
    // USERS (mirror profil + live location driver)
    // ============================================================

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, update: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow delete: if isAdmin();
    }

    // ============================================================
    // CUSTOMERS
    // ============================================================

    match /customers/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;

      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && customerProtectedFieldsUnchanged()
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && customerSaldoOnlyDecreased()
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // MITRA APPLICATIONS
    // - Pemilik & admin: seperti semula
    // - Customer login: READ saja untuk agent yang status == approved
    //   (Otak CGO discovery + radar "ada agent dekat?")
    // - Write status tetap dilindungi (mitra tidak bisa self-approve)
    // ============================================================

    match /mitra_applications/{docId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && isPublicApprovedAgent());

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // RESTO PROFILES (listing food.html + discovery CGO)
    // Sudah readable untuk user login — dipertahankan
    // ============================================================

    match /resto_profiles/{restoId} {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        || (signedIn() && request.auth.uid == restoId);

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == restoId);
    }

    // ============================================================
    // ORDER HELPERS
    // ============================================================

    function orderOwnedByUser() {
      return signedIn()
        && resource.data.get("userId", "") == request.auth.uid;
    }

    function newOrderOwnedByUser() {
      return signedIn()
        && request.resource.data.get("userId", "") == request.auth.uid;
    }

    function orderAssignedToDriver() {
      return signedIn()
        && resource.data.get("driverId", "") == request.auth.uid;
    }

    function orderRelatedToMitra() {
      return signedIn()
        && (
          resource.data.get("mitraId", "") == request.auth.uid
          || resource.data.get("restoId", "") == request.auth.uid
          || resource.data.get("restaurantId", "") == request.auth.uid
          || resource.data.get("agentId", "") == request.auth.uid
        );
    }

    // FIX KRITIS: driver/agent boleh klaim order yang belum punya assignee
    function isClaimingOrder() {
      return signedIn()
        && (
          (
            resource.data.get("driverId", "") == ""
            && request.resource.data.get("driverId", "") == request.auth.uid
          )
          || (
            resource.data.get("agentId", "") == ""
            && request.resource.data.get("agentId", "") == request.auth.uid
          )
          || (
            resource.data.get("mitraId", "") == ""
            && request.resource.data.get("mitraId", "") == request.auth.uid
          )
        );
    }

    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      allow create: if isAdmin() || newOrderOwnedByUser();

      allow get: if isAdmin()
        || orderOwnedByUser()
        || orderAssignedToDriver()
        || orderRelatedToMitra();

      allow list: if signedIn();

      allow update: if isAdmin()
        || orderOwnedByUser()
        || orderAssignedToDriver()
        || orderRelatedToMitra()
        || isClaimingOrder();

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin()
          || orderOwnedByUser()
          || orderAssignedToDriver()
          || orderRelatedToMitra();

        allow create: if isAdmin()
          || orderOwnedByUser()
          || orderAssignedToDriver()
          || orderRelatedToMitra();

        allow update, delete: if false;
      }
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {
      allow create: if signedIn();

      allow read, update: if signedIn()
        && (
          resource.data.get("userId", "") == request.auth.uid
          || resource.data.get("uid", "") == request.auth.uid
          || isAdmin()
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.get("userId", "") == request.auth.uid
            || resource.data.get("uid", "") == request.auth.uid
          )
        );
    }

    // ============================================================
    // WALLET TRANSACTIONS (log CikurPay)
    // ============================================================

    match /walletTransactions/{txId} {
      allow create: if signedIn()
        && request.resource.data.get("userId", "") == request.auth.uid;

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.get("userId", "") == request.auth.uid
        );

      allow update, delete: if false;
    }

    // ============================================================
    // BUNDLES (2IN1 FOOD + ASSISTANT)
    // ============================================================

    match /bundles/{bundleId} {
      allow create: if signedIn()
        && request.resource.data.get("userId", "") == request.auth.uid;

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.get("userId", "") == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.get("userId", "") == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    // ============================================================
    // APP CONFIG
    // ============================================================

    match /app_config/{document} {
      allow read, write: if isAdmin();
    }

    // ============================================================
    // SYSTEM LOGS
    // ============================================================

    match /system_logs/{document} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // MEDICINE / EXECUTOR — DIHAPUS (tidak dipakai)
    // ============================================================
  }
}
